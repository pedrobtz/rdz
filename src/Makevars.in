# Portable make: every object is listed by hand, since R compiles only
# src/*.c by itself and $(wildcard) would need GNU make. configure fills the
# @RUST_*@ fields: the Rust reference implementation's static library when
# cargo and rustc are available (and RDZ_RUST is not 0), nothing otherwise
# (plan-c.md, Stage B). The C implementation is always built.
#
# zstd (src/vendor/zstd/, see tools/vendor/) is compiled with its API's
# visibility attribute emptied, so that with $(C_VISIBILITY) none of its
# symbols leaves rdz.so; only R_init_rdz is exported. tools/vendor/verify
# checks these defines against tools/vendor/manifest.tsv.
PKG_CPPFLAGS = -I. -DZSTDLIB_VISIBLE= -DZSTDERRORLIB_VISIBLE= @RUST_CPPFLAGS@
PKG_CFLAGS = $(C_VISIBILITY)
PKG_LIBS = @RUST_LIBS@ -pthread

CORE_OBJECTS = core/rdz_codec.o core/rdz_container.o core/rdz_error.o core/rdz_io.o \
	core/rdz_graph.o core/rdz_logical.o core/rdz_native.o core/rdz_numeric.o core/rdz_pipeline.o \
	core/rdz_records.o core/rdz_string.o core/rdz_vector.o
OBJECTS = rdz_init.o rdz_r.o adapter/rdz_generic.o adapter/rdz_native_r.o $(CORE_OBJECTS) \
	vendor/zstd/zstd.o \
	@RUST_OBJECTS@
RUST_STATLIB = @RUST_STATLIB@

TARGET = @TARGET@

PROFILE = @PROFILE@
FEATURE_FLAGS = @FEATURE_FLAGS@

# Add flags if necessary
RUSTFLAGS =

TARGET_DIR = $(CURDIR)/rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/$(subst dev,debug,$(PROFILE))
STATLIB = $(LIBDIR)/librdz.a

CARGO_BUILD_ARGS = --jobs 2 --offline --locked --lib --profile $(PROFILE) $(FEATURE_FLAGS) --manifest-path=Cargo.toml --target-dir $(TARGET_DIR)

all: $(SHLIB) clean_intermediate

$(SHLIB): $(RUST_STATLIB)

$(STATLIB):
	# R's source cleanup can remove static archives from Cargo's build-script
	# output while leaving Cargo's freshness metadata. Refresh the affected
	# crates when that happens so repeated load_all(recompile = TRUE) works.
	if [ -d "$(LIBDIR)/build" ] && \
	   ! find "$(LIBDIR)/build" -path '*/savvy-*/out/*unwind_protect*' -print -quit | grep -q .; then \
	  cd rust && cargo clean --profile $(PROFILE) --package savvy --package savvy-ffi --manifest-path Cargo.toml --target-dir $(TARGET_DIR); \
	fi

	# In some environments, ~/.cargo/bin might not be included in PATH, so we need
	# to set it here to ensure cargo can be invoked. It is appended to PATH and
	# therefore is only used if cargo is absent from the user's PATH.
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	  export CC="$(CC)" && \
	  export CFLAGS="$(CFLAGS)" && \
	  export RUSTFLAGS="$(RUSTFLAGS)" && \
	  @BEFORE_CARGO_BUILD@ \
	  if [ "$(TARGET)" != "wasm32-unknown-emscripten" ]; then \
	    cd rust && cargo build $(CARGO_BUILD_ARGS); \
	  else \
	    export CARGO_PROFILE_DEV_PANIC="abort" && \
	    export CARGO_PROFILE_RELEASE_PANIC="abort" && \
	    export RUSTFLAGS="$(RUSTFLAGS) -Zdefault-visibility=hidden" && \
	    cd rust && cargo +nightly build $(CARGO_BUILD_ARGS) --target $(TARGET) -Zbuild-std=panic_abort,std; \
	  fi

clean_intermediate: $(SHLIB)
	rm -f $(STATLIB)

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) ./rust/target

.PHONY: all clean_intermediate clean
