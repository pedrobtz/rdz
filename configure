# Prefer a user rustup toolchain when present. R CMD check can prepend an older
# system Cargo to PATH even when the package-local toolchain is newer.
if [ -d "${HOME}/.cargo/bin" ]; then
  export PATH="${HOME}/.cargo/bin:${PATH}"
fi

MIN_RUST_VERSION="1.88.0"

if ! command -v cargo >/dev/null 2>&1 || ! command -v rustc >/dev/null 2>&1; then
  echo "-------------- ERROR: CONFIGURATION FAILED --------------------"
  echo ""
  echo "Cargo and rustc are both required to install rdz."
  echo "Install them with your system package manager or rustup:"
  echo ""
  echo "https://www.rust-lang.org/tools/install"
  echo ""
  echo "---------------------------------------------------------------"

  exit 1
fi

CARGO_VERSION="$(cargo --version)"
RUSTC_VERSION="$(rustc --version)"
CARGO_RELEASE="$(printf '%s\n' "${CARGO_VERSION}" | sed -n 's/^cargo \([0-9][0-9.]*\).*/\1/p')"
RUSTC_RELEASE="$(printf '%s\n' "${RUSTC_VERSION}" | sed -n 's/^rustc \([0-9][0-9.]*\).*/\1/p')"

version_at_least() {
  awk -v current="$1" -v required="$2" 'BEGIN {
    split(current, c, "."); split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      c[i] += 0; r[i] += 0
      if (c[i] > r[i]) exit 0
      if (c[i] < r[i]) exit 1
    }
    exit 0
  }'
}

if [ -z "${CARGO_RELEASE}" ] || [ -z "${RUSTC_RELEASE}" ] ||
   ! version_at_least "${CARGO_RELEASE}" "${MIN_RUST_VERSION}" ||
   ! version_at_least "${RUSTC_RELEASE}" "${MIN_RUST_VERSION}"; then
  echo "-------------- ERROR: CONFIGURATION FAILED --------------------"
  echo ""
  echo "rdz requires cargo and rustc ${MIN_RUST_VERSION} or newer."
  echo "Found: ${CARGO_VERSION}"
  echo "Found: ${RUSTC_VERSION}"
  echo "Please upgrade the Rust toolchain; rdz will not install it."
  echo ""
  echo "---------------------------------------------------------------"
  exit 1
fi

# Report the version of Rustc to comply with the CRAN policy
echo "using Rust package manager: '${CARGO_VERSION}'"
echo "using Rust compiler: '${RUSTC_VERSION}'"

if [ -f src/rust/vendor.tar.xz ]; then
  mkdir -p src/rust/vendor src/.cargo
  # R's internal untar decompresses xz itself, so no xz binary is needed.
  if ! "${R_HOME}/bin/Rscript" --vanilla -e \
    'stopifnot(utils::untar("src/rust/vendor.tar.xz", exdir = "src/rust/vendor", tar = "internal") == 0L)'; then
    echo "ERROR: failed to extract the vendored Rust crates from src/rust/vendor.tar.xz" >&2
    exit 1
  fi
  printf '%s\n' \
    '[source.crates-io]' \
    'replace-with = "vendored-sources"' \
    '[source.vendored-sources]' \
    'directory = "rust/vendor"' \
    '[net]' \
    'offline = true' \
    '[target.x86_64-pc-windows-msvc]' \
    'rustflags = ["-C", "link-arg=/FORCE:UNRESOLVED"]' > src/.cargo/config.toml
fi

if [ "$(uname)" = "Emscripten" ]; then
  TARGET="wasm32-unknown-emscripten"
fi

# allow overriding profile externally (e.g. on CI)
if [ -n "${SAVVY_PROFILE}" ]; then
  PROFILE="${SAVVY_PROFILE}"
# catch DEBUG envvar, which is passed from pkgbuild::compile_dll()
elif [ "${DEBUG}" = "true" ]; then
  PROFILE=dev
else
  PROFILE=release
fi

# e.g. SAVVY_FEATURES="a b"  -->  "--features 'a b'"
if [ -n "${SAVVY_FEATURES}" ]; then
  FEATURE_FLAGS="--features '${SAVVY_FEATURES}'"
fi

# Set macOS deployment target for the Rust cc crate.
#
# The cc crate (used by savvy's build.rs to compile unwind_protect_wrapper.c)
# does not derive the deployment target from CC/CFLAGS. Instead, it looks up
# MACOSX_DEPLOYMENT_TARGET, falling back to `xcrun --show-sdk-version`, and
# passes the result as -mmacosx-version-min=<value>. When the env var is unset,
# the fallback SDK version (e.g. 26.2) can be newer than the version R's
# compiler targets, producing an ld warning about version mismatch.
#
# We default to 11.0, the minimum deployment target for arm64 macOS. This
# should be safe because unwind_protect_wrapper.c is a fairly simple C code
# and uses no version-specific APIs.
if [ "$(uname)" = "Darwin" ]; then
  MACOSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-11.0}"
  echo "using macOS deployment target: ${MACOSX_DEPLOYMENT_TARGET}"
  BEFORE_CARGO_BUILD="${BEFORE_CARGO_BUILD}"' export MACOSX_DEPLOYMENT_TARGET="'"${MACOSX_DEPLOYMENT_TARGET}"'" \&\&'
fi

sed \
  -e "s/@TARGET@/${TARGET}/" \
  -e "s/@PROFILE@/${PROFILE}/" \
  -e "s/@FEATURE_FLAGS@/${FEATURE_FLAGS}/" \
  -e "s|@BEFORE_CARGO_BUILD@|${BEFORE_CARGO_BUILD}|" \
  src/Makevars.in > src/Makevars
